# KeeperHub — org-scoped API key, prefix kh_
# Get one at https://app.keeperhub.com → Settings → API Keys → "Organisation" tab
KEEPERHUB_API_KEY=

# KeeperHub network name as accepted by /api/execute/*
# Verified options: ethereum, base, polygon. Sepolia testnet exists; confirm exact `network` string via GET /api/chains.
KEEPERHUB_NETWORK=sepolia

# Treasury wallet — TESTNET ONLY, never paste a mainnet key here.
# This is the wallet the Worker's swaps spend FROM. Configure the same wallet in the KeeperHub dashboard so /api/execute/* can sign for it.
TREASURY_ADDRESS=
TREASURY_PRIVATE_KEY=

# LLM gateway — TokenRouter ($50 credits)
# Confirm base URL + auth header style from https://www.tokenrouter.com/docs
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=
TOKENROUTER_MODEL=

# 0G Storage (Worker action log) — fill once 0G integration starts
ZERO_G_RPC_URL=
ZERO_G_PRIVATE_KEY=

# ENS — fill once antibody.eth subnames are provisioned
ENS_PARENT_DOMAIN=antibody.eth
ENS_WORKER_SUBNAME=worker
ENS_GUARDIAN_SUBNAME=guardian
